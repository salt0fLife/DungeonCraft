[sub_resource type="Shader" id="Shader_a2toi"]
code = "
shader_type spatial;
render_mode blend_mix,depth_draw_opaque,cull_back,diffuse_burley,specular_schlick_ggx;
uniform sampler2D fire_noise : repeat_enable;
uniform vec3 fire_col : source_color;
uniform sampler2D gradient_tex;

void vertex() {
	MODELVIEW_MATRIX = VIEW_MATRIX * mat4(vec4(normalize(cross(vec3(0.0, 1.0, 0.0), INV_VIEW_MATRIX[2].xyz)), 0.0), vec4(0.0, 1.0, 0.0, 0.0), vec4(normalize(cross(INV_VIEW_MATRIX[0].xyz, vec3(0.0, 1.0, 0.0))), 0.0), MODEL_MATRIX[3]);
	MODELVIEW_NORMAL_MATRIX = mat3(MODELVIEW_MATRIX);
}






void fragment() {
	vec2 base_uv = UV;
	vec4 fire = texture(fire_noise,base_uv+vec2(0.0,TIME*2.0));
	fire *= texture(fire_noise,base_uv+vec2(0.25,TIME*3.2));
	vec4 gradient = texture(gradient_tex,base_uv+vec2(0.0,0.01));
	ALPHA = fire.a * gradient.r;
	ALBEDO = mix(fire_col,fire_col*vec3(0.7,0.7,0.1),fire.r*ALPHA);
	//ALBEDO *= gradient.r;
	EMISSION = ALBEDO*4.0;
	if (fire.r*gradient.r < 0.05) {
		ALPHA = 0.0;
	}
}
"

